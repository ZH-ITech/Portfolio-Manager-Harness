# ================= Model provider =================
# Option A (DEFAULT, free, hosted open-source model): Groq free tier
#   1) sign in at console.groq.com (no card)  2) API Keys -> Create  3) paste below
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
MAIN_MODEL=llama-3.3-70b-versatile
SUBAGENT_MODEL=llama-3.3-70b-versatile
# Free tiers limit tokens per minute; smaller tool results and earlier compaction help.
TOOL_RESULT_CHAR_LIMIT=3000
COMPACTION_CHAR_BUDGET=25000

# Option B (free, fully offline, open-source model on your own computer): Ollama
#   1) install from ollama.com  2) ollama pull qwen2.5:7b  3) use these values instead
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=
#   MAIN_MODEL=qwen2.5:7b
#   SUBAGENT_MODEL=qwen2.5:7b
#   LLM_TIMEOUT_S=300          (CPU models are slow)
#   Note: small local models are weaker at multi-step tool use than a 70B model.

# Option C (paid, strongest results): Claude
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   MAIN_MODEL=claude-sonnet-5-5
#   SUBAGENT_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# ================= App =================
# true = run jobs inline without Redis/Celery (local dev); false in docker compose and production
CELERY_EAGER=true
REDIS_URL=redis://redis:6379/0
DB_PATH=data/harness.db
SANDBOX_TIMEOUT_S=20
SANDBOX_MEMORY_MB=512
PTC_PROXY_URL=http://127.0.0.1:8000/internal/tools
PTC_SHARED_SECRET=change-me
MAX_TOOL_CALLS=30
MAX_SANDBOX_RUNS=8
HISTORY_TURNS=10
